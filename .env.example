# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cost Governor & Strict Budget Rules
# ALLOW_PAID_AI: Set to true only if you explicitly allow paid API calls. Defaults to false.
ALLOW_PAID_AI="false"

# HARD_DAILY_BUDGET_USD: Daily dollar ceiling before freezing paid calls (e.g. 0.50)
HARD_DAILY_BUDGET_USD="0.50"

# Optional Alternative Free Providers for the AI Gateway
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
CLOUDFLARE_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
